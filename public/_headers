# Cloudflare Pages cache headers (netlify.toml / vercel.json don't apply here).
# Hashed bundles are immutable; game art under /img/ is content-stable, so a
# long browser cache + SW stale-while-revalidate covers the rare replacement.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=86400

/icons.svg
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=86400
