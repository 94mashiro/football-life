{
  "name": "football-life",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "regress": "tsx tools/regress.ts",
    "regress:bless": "tsx tools/regress.ts --bless",
    "regress:full": "tsx tools/regress-full.ts",
    "preview": "vite preview",
    "deploy": "npm run build && vercel --prod",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist --project-name=football-life"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "html-to-image": "^1.11.13",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
